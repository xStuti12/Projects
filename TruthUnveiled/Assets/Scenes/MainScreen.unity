    m_Modifications:
    - target: {fileID: 4113952186643792330, guid: 7ad43040240edd14486742e8a7b2af6a, type: 3}
      propertyPath: m_Text
      value: "Rules :\nYou have 3 action points per day and each action costs one
        point\nYou can spend them by learning or debunking articles on the internet\nLearning
        makes you more specialised in the available categories\nThe goal is to get
        the public on your side by debunking articles succesfully\nSleeping refreshes
        your action points but there is also a chance of an event occuring\nEvents
        can be positive, negative or neutral and will affect action points accordingly.\nAdditionally,
        you have your unique skills as a journalist which help you with writing convincing
        articles and with the research of categories\n "
      objectReference: {fileID: 0}
